# Native USB belongs exclusively to the CDC host. UART0 uses the USB-UART chip.
# Match the N16R8 board's quad flash; DIO faults during PSRAM heap startup
# on the prototype's S3 revision 0.2 (ESP-IDF issue 18806).
CONFIG_ESPTOOLPY_FLASHMODE_DIO=n
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_TINYUSB_CDC_ENABLED=n
CONFIG_FN_FUJIBUS_TRANSPORT_USB_CDC=n
CONFIG_ESP_CONSOLE_NONE=n
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_USB_CDC=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=n
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=n
CONFIG_FN_CONSOLE_TRANSPORT_UART0=y
CONFIG_FN_CONSOLE_TRANSPORT_USB_CDC=n
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=n
CONFIG_BOOTLOADER_LOG_LEVEL_ERROR=y
CONFIG_BOOTLOADER_LOG_LEVEL=1
